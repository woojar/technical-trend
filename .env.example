# Copy to .env and fill in whichever you have. Everything here is optional:
# with no keys at all the digest still builds, using headlines and upstream
# excerpts instead of model-written summaries.
#
# .env is gitignored. In GitHub Actions use repository secrets instead.

# --- LLM providers (one is enough; the rest act as fallbacks) ---------------

# Recommended first choice. Free tier, no card required.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://openrouter.ai/keys  (use model slugs ending in ":free")
OPENROUTER_API_KEY=

# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Local Ollama needs no key. Just `ollama serve` and pull the model in config.yaml.

# --- Sources ---------------------------------------------------------------

# Optional. Raises the GitHub Search API limit from 10 to 30 requests/minute.
# A classic token with no scopes is sufficient; public search needs no access.
# In GitHub Actions, pass the automatic ${{ secrets.GITHUB_TOKEN }} instead.
GITHUB_TOKEN=

# --- Delivery (optional) ---------------------------------------------------

# Leave blank to skip. Only used when running with --notify.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
